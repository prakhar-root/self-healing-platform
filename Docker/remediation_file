FROM python:3.12-slim
# Ansible needs a UTF-8 locale
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.162.0 uvicorn==0.54.0 requests==2.34.2 \
    ansible-core==2.21.5 docker==7.2.0
RUN ansible-galaxy collection install community.docker
COPY remediation_service.py restart_container.yml scale_service.yml ./
EXPOSE 8002
CMD ["uvicorn", "remediation_service:app", "--host", "0.0.0.0", "--port", "8002"]